<script>
  import { gsap } from "gsap";

  const svg = document.querySelector<SVGSVGElement>("[data-creative-dev-svg]");
  if (!svg) throw new Error("CreativeDev SVG not found");

  const REDUCED_MOTION_QUERY = "(prefers-reduced-motion: reduce)";
  const reduceMotion = window.matchMedia(REDUCED_MOTION_QUERY).matches;

  function animateFill(targetSvg: SVGSVGElement) {
    const clipRect = targetSvg.querySelector<SVGRectElement>("[data-creative-dev-clip-rect]");
    if (!clipRect) return;

    const totalWidth = 1920;

    if (reduceMotion) {
      clipRect.setAttribute("width", `${totalWidth}`);
      return;
    }

    gsap.fromTo(
      clipRect,
      { attr: { width: 0 } },
      {
        attr: { width: totalWidth },
        duration: 1.4,
        ease: "power2.inOut",
      }
    );
  }

  const fillObserver =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              if (svg.dataset.fillDone === "true") return;
              svg.dataset.fillDone = "true";
              animateFill(svg);
              fillObserver?.unobserve(svg);
            });
          },
          { threshold: 0.2 }
        )
      : null;

  if (fillObserver) {
    fillObserver.observe(svg);
  } else {
    animateFill(svg);
  }
</script>
