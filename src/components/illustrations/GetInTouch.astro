<script>
  import { gsap } from "gsap";

  const svg = document.querySelector<SVGSVGElement>("[data-get-in-touch-svg]");
  if (!svg) throw new Error("GetInTouch SVG not found");

  const DRAW_REDUCED_MOTION_QUERY = "(prefers-reduced-motion: reduce)";
  const reduceDrawMotion = window.matchMedia(DRAW_REDUCED_MOTION_QUERY).matches;

  function animateDrawSvg(targetSvg: SVGSVGElement) {
    const paths = Array.from(targetSvg.querySelectorAll<SVGPathElement>("path"));
    if (paths.length === 0) return;

    paths.forEach((path) => {
      const computed = getComputedStyle(path);
      const fill = computed.fill;

      const hasFill = fill !== "none" && fill !== "transparent" && fill !== "rgba(0, 0, 0, 0)";

      const length = path.getTotalLength();
      path.style.stroke = "var(--color-foreground)";
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;
      path.style.strokeLinecap = "round";
      path.style.strokeLinejoin = "round";
      if (computed.strokeWidth === "0px" || computed.strokeWidth === "0") {
        path.style.strokeWidth = "2";
      }

      if (hasFill) {
        path.dataset.drawHasFill = "1";
        path.style.fillOpacity = "0";
      } else {
        path.dataset.drawHasFill = "0";
      }

      if (reduceDrawMotion) {
        path.style.strokeDashoffset = "0";
        if (hasFill) {
          path.style.fillOpacity = "1";
        }
      }
    });

    if (reduceDrawMotion) return;

    const filledPaths = paths.filter((p) => p.dataset.drawHasFill === "1");

    const tl = gsap.timeline();
    tl.to(paths, { strokeDashoffset: 0, duration: 1.2, ease: "power2.out", stagger: 0.08 }, 0);

    if (filledPaths.length > 0) {
      tl.to(filledPaths, { fillOpacity: 1, duration: 0.25, ease: "power1.out", stagger: 0.08 }, 0.65);
      tl.to(filledPaths, { strokeOpacity: 0, duration: 0.25, ease: "power1.out", stagger: 0.02 }, 0.9);
    }
  }

  const drawObserver =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              if (svg.dataset.drawDone === "true") return;
              svg.dataset.drawDone = "true";
              animateDrawSvg(svg);
              drawObserver?.unobserve(svg);
            });
          },
          { threshold: 0.2 },
        )
      : null;

  if (drawObserver) {
    drawObserver.observe(svg);
  } else {
    animateDrawSvg(svg);
  }
</script>
