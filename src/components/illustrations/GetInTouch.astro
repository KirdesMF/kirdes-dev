  "M1155.24,354.62V59.25c0-43.22,27.28-59.25,92.05-59.25s92.04,16.04,92.04,59.25v295.36c0,43.22-27.28,59.07-92.04,59.07s-92.05-15.85-92.05-59.07ZM1260.74,350.14V63.73c0-9.31-4.73-12.25-13.46-12.25s-13.46,2.94-13.46,12.25v286.4c0,9.31,4.72,12.25,13.46,12.25s13.46-2.94,13.46-12.25Z",
