---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...props } = Astro.props;

const PATHS = [
  "M0,361.13V59.25C0,16.04,27.28,0,92.05,0s92.04,16.04,92.04,59.25v96.86h-78.59V63.73c0-9.31-4.73-12.25-13.46-12.25s-13.46,2.94-13.46,12.25v286.4c0,9.31,4.72,12.25,13.46,12.25s13.46-2.94,13.46-12.25v-115.62h-20.14v-52.01h98.73v227.04h-77.37v-12.99c-7.6,10.91-29.2,17.13-47.89,17.13-35.66,0-58.83-13.23-58.83-52.55Z",
  "M193.56,4.14h140v53.92h-61.41v119.76h61.41v53.92h-61.41v124.06h61.41v53.74h-140V4.14Z",
  "M392.52,58.06h-49.49V4.14h177.58v53.92h-49.49v351.48h-78.59V58.06Z",
  "M596.44,4.14h78.59v405.4h-78.59V4.14Z",
  "M684.61,4.14h104.32l39.14,270.88h1.54l-8.52-189.18V4.14h73.75v405.4h-104.32l-38.43-264.31h-1.54l7.81,185.57v78.73h-73.75V4.14Z",
