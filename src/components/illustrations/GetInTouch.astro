---

<div class:list={["relative", className]} data-get-in-touch-root style="--lens-mask-radius: var(--lens-radius);" {...props}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 413.69" class="size-full" aria-hidden="true">
    <g class="stroke-foreground fill-none stroke-2">
      {PATHS.map((path) => <path d={path}></path>)}
    </g>
  </svg>

  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 413.69" class="pointer-events-none absolute inset-0 size-full masked-hide-local" data-get-in-touch-fill-svg aria-hidden="true">
    <defs>
      <clipPath id="get-in-touch-fill-clip">
        <rect data-get-in-touch-fill-clip-rect x="0" y="0" width="0" height="413.69" />
      </clipPath>
    </defs>
    <g class="fill-foreground" clip-path="url(#get-in-touch-fill-clip)">
      {PATHS.map((path) => <path d={path}></path>)}
    </g>
  </svg>

  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 413.69" class="pointer-events-none absolute inset-0 size-full masked-reveal-local text-foreground" style="color: var(--color-foreground);" data-get-in-touch-hatch-svg aria-hidden="true">
    <defs>
      <clipPath id="get-in-touch-hatch-clip">
        <rect data-get-in-touch-hatch-clip-rect x="0" y="0" width="0" height="413.69" />
      </clipPath>
    </defs>
    <g fill="url(#pattern-frame-striped)" clip-path="url(#get-in-touch-hatch-clip)">
      {PATHS.map((path) => <path d={path}></path>)}
    </g>
  </svg>
</div>

<script>
  import { gsap } from "gsap";
  import { bindLocalLensMask } from "../lens/local-mask";

  const root = document.querySelector<HTMLElement>("[data-get-in-touch-root]");
  if (!root) throw new Error("GetInTouch root not found");

  const fillSvg = root.querySelector<SVGSVGElement>("[data-get-in-touch-fill-svg]");
  const hatchSvg = root.querySelector<SVGSVGElement>("[data-get-in-touch-hatch-svg]");
  if (!fillSvg || !hatchSvg) throw new Error("GetInTouch fill SVGs not found");

  bindLocalLensMask({ container: root, target: root, mode: "always" });

  const REDUCED_MOTION_QUERY = "(prefers-reduced-motion: reduce)";
  const reduceMotion = window.matchMedia(REDUCED_MOTION_QUERY).matches;

  function animateFill(targetRoot: HTMLElement) {
    const clipRects = Array.from(
      targetRoot.querySelectorAll<SVGRectElement>(
        "[data-get-in-touch-fill-clip-rect], [data-get-in-touch-hatch-clip-rect]",
      ),
    );
    if (clipRects.length === 0) return;

    const totalWidth = 1920;

    if (reduceMotion) {
      clipRects.forEach((clipRect) => {
        clipRect.setAttribute("width", `${totalWidth}`);
      });
      return;
    }

    gsap.fromTo(
      clipRects,
      { attr: { width: 0 } },
      {
        attr: { width: totalWidth },
        duration: 1.4,
        ease: "power2.inOut",
      },
    );
  }

  const fillObserver =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              if (root.dataset.fillDone === "true") return;
              root.dataset.fillDone = "true";
              animateFill(root);
              fillObserver?.unobserve(root);
            });
          },
          { threshold: 0.2 },
        )
      : null;

  if (fillObserver) {
    fillObserver.observe(root);
  } else {
    animateFill(root);
  }
</script>
