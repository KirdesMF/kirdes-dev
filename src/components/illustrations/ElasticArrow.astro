<svg
  data-elastic-arrow
  data-arrow-svg
  viewBox="0 0 100 100"
  class="w-full h-[1em] overflow-visible"
  preserveAspectRatio="none"
  aria-hidden="true"
  role="img"
>
  <path
    data-arrow-path
    d="M0 50 Q42.5 50 100 50"
    stroke="currentColor"
    fill="none"
    stroke-width="10"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></path>
  <path
    data-arrow-head="top"
    d="M68 30 Q80 42 100 50"
    stroke="currentColor"
    fill="none"
    stroke-width="10"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></path>
  <path
    data-arrow-head="bottom"
    d="M68 70 Q80 58 100 50"
    stroke="currentColor"
    fill="none"
    stroke-width="10"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></path>
</svg>

<script>
  import { gsap } from "gsap";

  const config = {
    snapDistance: 6,
    releaseDistance: 5,
    duration: 1,
    ease: "elastic.out(1, 0.1)",
  };

  type Point = { x: number; y: number };

  function normalizeVector(vector: Point) {
    const length = Math.hypot(vector.x, vector.y);
    if (length === 0) return { x: 1, y: 0 };
    return { x: vector.x / length, y: vector.y / length };
  }

  function applyMatrixToPoint(matrix: DOMMatrixReadOnly, point: Point): Point {
    return {
      x: point.x * matrix.a + point.y * matrix.c + matrix.e,
      y: point.x * matrix.b + point.y * matrix.d + matrix.f,
    };
  }

  function applyMatrixToVector(matrix: DOMMatrixReadOnly, vector: Point): Point {
    return {
      x: vector.x * matrix.a + vector.y * matrix.c,
      y: vector.x * matrix.b + vector.y * matrix.d,
    };
  }

  function initElasticArrow(arrowSvg: SVGSVGElement) {
    if (arrowSvg.dataset.elasticArrowInitialized === "true") return;
    arrowSvg.dataset.elasticArrowInitialized = "true";

    const arrowPath = arrowSvg.querySelector<SVGPathElement>("[data-arrow-path]");
    const arrowHeadTop = arrowSvg.querySelector<SVGPathElement>("[data-arrow-head='top']");
    const arrowHeadBottom = arrowSvg.querySelector<SVGPathElement>("[data-arrow-head='bottom']");

    if (!arrowPath || !arrowHeadTop || !arrowHeadBottom) throw new Error("Arrow paths not found");

    const line = {
      start: { x: 0, y: 50 },
      control: { x: 42.5, y: 50 },
      end: { x: 100, y: 50 },
      defaultControlY: 50,
      connected: false,
    };

    let needsRender = false;

    const arrowStrokeWidth = Number(arrowPath.getAttribute("stroke-width") ?? "10");
    const arrowHead = {
      length: arrowStrokeWidth * 3.2,
      width: arrowStrokeWidth * 2,
      controlLength: arrowStrokeWidth * 2,
      controlWidth: arrowStrokeWidth * 0.8,
    };

    function toQuadraticPath() {
      const { start, control, end } = line;
      return `M${start.x} ${start.y} Q${control.x} ${control.y} ${end.x} ${end.y}`;
    }

    function getPointOnCurve(t: number): Point {
      const inv = 1 - t;
      const { start, control, end } = line;
      return {
        x: inv * inv * start.x + 2 * inv * t * control.x + t * t * end.x,
        y: inv * inv * start.y + 2 * inv * t * control.y + t * t * end.y,
      };
    }

    function clamp01(value: number) {
      return Math.max(0, Math.min(1, value));
    }

    function getClosestParameter(point: Point) {
      const { start, control, end } = line;

      const ax = start.x - 2 * control.x + end.x;
      const ay = start.y - 2 * control.y + end.y;
      const bx = 2 * (control.x - start.x);
      const by = 2 * (control.y - start.y);
      const cx = start.x - point.x;
      const cy = start.y - point.y;

      const c0 = cx * bx + cy * by;
      const c1 = cx * 2 * ax + bx * bx + cy * 2 * ay + by * by;
      const c2 = 3 * ax * bx + 3 * ay * by;
      const c3 = 2 * ax * ax + 2 * ay * ay;

      let t = 0.5;
      for (let i = 0; i < 5; i++) {
        const g = ((c3 * t + c2) * t + c1) * t + c0;
        const gPrime = c1 + 2 * c2 * t + 3 * c3 * t * t;
        if (Math.abs(gPrime) < 1e-6) break;
        t = clamp01(t - g / gPrime);
      }

      return clamp01(t);
    }

    function getDistanceToLine(point: Point) {
      const t = getClosestParameter(point);
      const candidates = [0, 1, t];
      let minDistance = Infinity;

      for (const candidate of candidates) {
        const curvePoint = getPointOnCurve(candidate);
        const distance = Math.hypot(point.x - curvePoint.x, point.y - curvePoint.y);
        if (distance < minDistance) minDistance = distance;
      }

      return minDistance;
    }

    function connectLine() {
      if (line.connected) return;
      line.connected = true;
      gsap.killTweensOf(line.control);
    }

    function requestRender() {
      needsRender = true;
    }

    function releaseLine() {
      if (!line.connected) return;
      line.connected = false;
      gsap.killTweensOf(line.control);
      gsap.to(line.control, {
        y: line.defaultControlY,
        duration: config.duration,
        ease: config.ease,
        onUpdate: requestRender,
      });
    }

    function getSVGCoordinates(svg: SVGSVGElement, event: PointerEvent): Point {
      const point = svg.createSVGPoint();
      point.x = event.clientX;
      point.y = event.clientY;
      const ctm = svg.getScreenCTM();
      return point.matrixTransform(ctm?.inverse());
    }

    function updateArrowHead() {
      const ctm = arrowSvg.getScreenCTM();
      const inv = ctm?.inverse();
      if (!ctm || !inv) return;

      const tangentSvg = { x: line.end.x - line.control.x, y: line.end.y - line.control.y };
      const tangentScreen = applyMatrixToVector(ctm, tangentSvg);

      const direction = normalizeVector(tangentScreen);
      const normal = { x: -direction.y, y: direction.x };

      const tipScreen = applyMatrixToPoint(ctm, line.end);

      const baseScreen = {
        x: tipScreen.x - direction.x * arrowHead.length,
        y: tipScreen.y - direction.y * arrowHead.length,
      };

      const topStartScreen = {
        x: baseScreen.x - normal.x * arrowHead.width,
        y: baseScreen.y - normal.y * arrowHead.width,
      };

      const bottomStartScreen = {
        x: baseScreen.x + normal.x * arrowHead.width,
        y: baseScreen.y + normal.y * arrowHead.width,
      };

      const controlBaseScreen = {
        x: tipScreen.x - direction.x * arrowHead.controlLength,
        y: tipScreen.y - direction.y * arrowHead.controlLength,
      };

      const topControlScreen = {
        x: controlBaseScreen.x - normal.x * arrowHead.controlWidth,
        y: controlBaseScreen.y - normal.y * arrowHead.controlWidth,
      };

      const bottomControlScreen = {
        x: controlBaseScreen.x + normal.x * arrowHead.controlWidth,
        y: controlBaseScreen.y + normal.y * arrowHead.controlWidth,
      };

      const topStart = applyMatrixToPoint(inv, topStartScreen);
      const bottomStart = applyMatrixToPoint(inv, bottomStartScreen);
      const topControl = applyMatrixToPoint(inv, topControlScreen);
      const bottomControl = applyMatrixToPoint(inv, bottomControlScreen);

      arrowHeadTop?.setAttribute(
        "d",
        `M${topStart.x} ${topStart.y} Q${topControl.x} ${topControl.y} ${line.end.x} ${line.end.y}`,
      );
      arrowHeadBottom?.setAttribute(
        "d",
        `M${bottomStart.x} ${bottomStart.y} Q${bottomControl.x} ${bottomControl.y} ${line.end.x} ${line.end.y}`,
      );
    }

    function updateLine() {
      if (line.connected && Math.abs(line.control.y - line.defaultControlY) > config.releaseDistance) {
        releaseLine();
      }
      arrowPath?.setAttribute("d", toQuadraticPath());
      updateArrowHead();
    }

    function onPointerMove(event: PointerEvent) {
      const point = getSVGCoordinates(arrowSvg, event);
      const distance = getDistanceToLine(point);
      if (distance <= config.snapDistance) {
        connectLine();
      }

      if (!line.connected) return;
      line.control.y = point.y * 2 - (line.start.y + line.end.y) / 2;
      requestRender();
    }

    function onPointerLeave() {
      releaseLine();
    }

    gsap.ticker.add(() => {
      if (!needsRender) return;
      needsRender = false;
      updateLine();
    });

    arrowSvg.addEventListener("pointermove", onPointerMove, { passive: true });
    arrowSvg.addEventListener("pointerleave", onPointerLeave);
    arrowSvg.addEventListener("pointercancel", onPointerLeave);
    window.addEventListener("resize", requestRender, { passive: true });

    requestRender();
  }

  document.querySelectorAll<SVGSVGElement>("[data-elastic-arrow]").forEach(initElasticArrow);
</script>
