---
import ServiceCard from "./ServiceCard.astro";

export type ServiceCardItem = {
  count: number;
  hasLine?: boolean;
  class?: string;
};

export type Props = {
  items?: ServiceCardItem[];
  class?: string;
};

const { items = [{ count: 1, hasLine: false }, { count: 2 }, { count: 3 }, { count: 4 }], class: className = "" } =
  Astro.props;
---

<div data-service-cards class:list={["grid grid-cols-12 gap-6", className]}>
  {items.map((item) => <ServiceCard count={item.count} hasLine={item.hasLine} class={item.class ?? "col-span-3"} />)}
</div>

<script>
  import { gsap } from "gsap";

  type CleanupFn = () => void;

  type LiquidState = {
    progress: number;
    curve: number;
  };

  const CARD_W = 100;
  const CARD_H = 100;

  function getPath(progress: number, curve: number): string {
    const currentY = CARD_H * (1 - progress);
    return `M 0 0 L 0 ${currentY} Q ${CARD_W / 2} ${currentY + curve} ${CARD_W} ${currentY} L ${CARD_W} 0 Z`;
  }

  function init(root: HTMLElement): CleanupFn {
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-service-card]"));
    if (cards.length === 0) return () => {};

    const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches ?? false;

    const svgs = cards
      .map((card) => card.querySelector<SVGSVGElement>("[data-service-liquid-svg]"))
      .filter((el): el is SVGSVGElement => Boolean(el));
    const paths = cards.map((card) => card.querySelector<SVGPathElement>("[data-service-liquid-path]"));
    const liquid = paths.map<LiquidState>(() => ({ progress: 0, curve: 0 }));

    let timeline: gsap.core.Timeline | null = null;

    gsap.killTweensOf(cards);
    gsap.killTweensOf(liquid);
    gsap.killTweensOf(svgs);

    if (!reduceMotion) {
      gsap.set(cards, { opacity: 0, y: 120 });
      gsap.set(svgs, { opacity: 1 });

      liquid.forEach((state, i) => {
        state.progress = 0;
        state.curve = 0;
        const path = paths[i];
        if (!path) return;
        path.setAttribute("d", getPath(0, 0));
      });

      const tl = gsap.timeline({ paused: true });
      const baseOffset = 0;
      const stagger = 0.12;

      cards.forEach((card, i) => {
        const path = paths[i];
        const state = liquid[i];
        const startAt = baseOffset + i * stagger;

        tl.to(
          card,
          {
            y: 0,
            opacity: 1,
            duration: 0.9,
            ease: "power3.out",
          },
          startAt,
        );

        if (!path) return;

        const update = () => {
          path.setAttribute("d", getPath(state.progress, state.curve));
        };

        tl.to(
          state,
          {
            progress: 1,
            duration: 0.8,
            ease: "power2.out",
            onUpdate: update,
          },
          startAt,
        );

        tl.to(
          state,
          {
            curve: 18,
            duration: 0.18,
            ease: "power1.out",
            onUpdate: update,
          },
          startAt,
        );

        tl.to(
          state,
          {
            curve: 0,
            duration: 1.0,
            ease: "elastic.out(1, 0.4)",
            onUpdate: update,
          },
          startAt + 0.18,
        );
      });

      timeline = tl;
    } else {
      gsap.set(cards, { opacity: 1, y: 0 });
      gsap.set(svgs, { opacity: 1 });
    }

    let observer: IntersectionObserver | null = null;
    if ("IntersectionObserver" in window) {
      const threshold = 0.35;
      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const isInView = entry.intersectionRatio >= threshold;

            if (reduceMotion) {
              gsap.to(svgs, {
                opacity: isInView ? 0 : 1,
                duration: 0.35,
                ease: "power1.out",
                overwrite: "auto",
              });
              continue;
            }

            if (isInView) timeline?.play();
            else timeline?.reverse();
          }
        },
        { threshold },
      );
      observer.observe(root);
    } else {
      if (reduceMotion) {
        gsap.to(svgs, { opacity: 0, duration: 0.35, ease: "power1.out", overwrite: "auto" });
      } else {
        timeline?.play();
      }
    }

    return () => {
      observer?.disconnect();
      timeline?.kill();
    };
  }

  const cleanups: CleanupFn[] = [];

  document.querySelectorAll<HTMLElement>("[data-service-cards]").forEach((root) => {
    if (root.dataset.serviceCardsInit === "true") return;
    root.dataset.serviceCardsInit = "true";
    cleanups.push(init(root));
  });

  window.addEventListener("beforeunload", () => {
    cleanups.forEach((fn) => fn());
    cleanups.length = 0;
  });
</script>
