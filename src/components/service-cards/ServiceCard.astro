---
export type Props = {
	count: number;
	hasLine?: boolean;
	class?: string;
};

const { count, hasLine = true, class: className = "" } = Astro.props;
---

<div data-service-card class:list={["relative p-2", className]}>
  <svg
    data-service-liquid-svg
    class="absolute inset-0 size-full z-10 pointer-events-none"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      data-service-liquid-path
      d="M 0 0 L 0 100 Q 50 100 100 100 L 100 0 Z"
      fill="currentColor"
      vector-effect="non-scaling-stroke"></path>
  </svg>

  <div class="grid relative z-0">
    <p data-masked class="text-[30vh] text-center col-start-1 col-end-2 row-start-1 row-end-2 masked-hide">{count}</p>
    <p data-masked class="text-[30vh] text-center absolute inset-0 text-stroke text-transparent masked-reveal">
      {count}
    </p>
  </div>

  {
    hasLine && (
      <svg
        class="absolute inset-y-0 start-0 w-px h-full z-20"
        viewBox="0 0 1 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M0.5 0 V100" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
      </svg>
    )
  }
</div>
