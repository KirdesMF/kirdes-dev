---
export type Props = {
	text: string;
	class?: string;
};

const { text, class: className } = Astro.props;
---

<span class:list={["relative inline-block overflow-hidden", className]} data-split-heading data-split-text={text}>
  <span data-split-fallback class="inline-block">{text}</span>
  <span
    aria-hidden="true"
    data-split-layer
    data-split-slice="left"
    class="absolute inset-0 pointer-events-none opacity-0"
    style="clip-path: inset(0 calc(100% * 2 / 3) 0 0);"
  >
    {text}
  </span>
  <span
    aria-hidden="true"
    data-split-layer
    data-split-slice="center"
    class="absolute inset-0 pointer-events-none opacity-0"
    style="clip-path: inset(0 calc(100% / 3) 0 calc(100% / 3));"
  >
    {text}
  </span>
  <span
    aria-hidden="true"
    data-split-layer
    data-split-slice="right"
    class="absolute inset-0 pointer-events-none opacity-0"
    style="clip-path: inset(0 0 0 calc(100% * 2 / 3));"
  >
    {text}
  </span>
</span>

<script>
  import { setupSplitHeadings } from "./split-heading";

  setupSplitHeadings();
</script>
