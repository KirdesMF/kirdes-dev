---
import { defaultLang, ui } from "../i18n/ui";
import CloseIcon from "./icons/CloseIcon.astro";
import { useTranslations } from "../i18n/utils";

type Props = {
	lang?: keyof typeof ui;
};

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div
	data-menu-root
	data-open-label={t("menu.open")}
	data-close-label={t("menu.close")}
	class="contents"
>
	<button
		type="button"
		data-menu-toggle
		class="border px-4 py-1 fixed tracking-wider right-4 top-4 z-50"
		aria-haspopup="dialog"
		aria-expanded="false"
	>
		{t("menu.open")}
	</button>

  <div data-menu class="fixed inset-0 z-40 opacity-0 pointer-events-none" aria-hidden="true" inert>
    <svg
      data-menu-svg
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      class="absolute inset-0 size-full pointer-events-none"
      aria-hidden="true"
    >
      <defs>
        <mask
          id="menu-zigzag-mask"
          x="-30"
          y="-30"
          width="160"
          height="160"
          maskUnits="userSpaceOnUse"
          maskContentUnits="userSpaceOnUse"
        >
          <rect x="-30" y="-30" width="160" height="160" fill="black"></rect>
          <path
            data-menu-mask-path
            fill="none"
            stroke="white"
            stroke-width="76"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </mask>
      </defs>
      <rect x="0" y="0" width="100" height="100" fill="var(--color-foreground)" mask="url(#menu-zigzag-mask)"></rect>
	    </svg>

		<button
			type="button"
			data-menu-close
			aria-label={t("menu.close")}
			class="absolute right-4 top-4 z-10 flex size-11 items-center justify-center border border-background text-background pointer-events-auto"
		>
			<CloseIcon class="size-5" />
		</button>

		<nav class="absolute inset-0 grid place-items-center pointer-events-none">
			<ul class="text-7xl font-bold tracking-tight leading-none space-y-4 pointer-events-auto text-background">
				<li><a data-menu-item href="#intro">{t("menu.intro")}</a></li>
				<li><a data-menu-item href="#works">{t("menu.works")}</a></li>
				<li><a data-menu-item href="#process">{t("menu.process")}</a></li>
				<li><a data-menu-item href="#about">{t("menu.about")}</a></li>
				<li><a data-menu-item href="#footer">{t("menu.footer")}</a></li>
			</ul>
		</nav>
	</div>
</div>

<script>
  import { events } from "../lib/states";
  import { gsap } from "gsap";

  const format = (value: number) => Number(value.toFixed(4));
  const brushstrokePath = (passes = 3) => {
    const overshoot = 20;
    const left = -overshoot;
    const right = 100 + overshoot;
    const top = -overshoot;
    const totalHeight = 100 + overshoot * 2;
    const sweepHeight = totalHeight / passes;

    let d = `M${left} ${top}`;
    let currentX = left;

    for (let i = 0; i < passes; i++) {
      const nextX = currentX === left ? right : left;
      const controlX = currentX === left ? right + 8 : left - 8;
      const controlY = top + sweepHeight * (i + 0.5);
      const endY = top + sweepHeight * (i + 1);

      d += ` Q${format(controlX)} ${format(controlY)} ${format(nextX)} ${format(endY)}`;
      currentX = nextX;
    }

    return d;
  };

		  document.querySelectorAll<HTMLElement>("[data-menu-root]").forEach((root) => {
		    const menuToggleBtn = root.querySelector<HTMLButtonElement>("[data-menu-toggle]");
		    const menu = root.querySelector<HTMLDivElement>("[data-menu]");
		    const menuCloseBtn = root.querySelector<HTMLButtonElement>("[data-menu-close]");
		    const menuMaskPath = root.querySelector<SVGPathElement>("[data-menu-mask-path]");
		    const menuItems = Array.from(root.querySelectorAll<HTMLElement>("[data-menu-item]"));
		    const openLabel = root.dataset.openLabel ?? "Menu";

		    if (!menuToggleBtn || !menu) return;

		    const MENU_DURATION = 0.82;
		    let isMenuOpen = false;

	    const setupMenuMask = () => {
      if (!menuMaskPath) return null;
      menuMaskPath.setAttribute("d", brushstrokePath(3));

      const length = menuMaskPath.getTotalLength();
      gsap.set(menuMaskPath, {
        attr: { "stroke-dasharray": length, "stroke-dashoffset": length },
      });
      return length;
    };

    const menuMaskLength = setupMenuMask();

    const menuTl = gsap.timeline({
      paused: true,
      defaults: { duration: MENU_DURATION, ease: "power2.inOut" },
      onStart: () => {
        menu.style.pointerEvents = "auto";
        menu.style.opacity = "1";
        menu.removeAttribute("inert");
        menu.setAttribute("aria-hidden", "false");
        document.documentElement.style.overflow = "hidden";
      },
      onReverseComplete: () => {
        menu.style.pointerEvents = "none";
        menu.style.opacity = "0";
        menu.setAttribute("inert", "");
        menu.setAttribute("aria-hidden", "true");
        document.documentElement.style.overflow = "";
      },
    });

    menuTl.set(menuItems, { opacity: 0, y: 18 }, 0);
    if (menuMaskPath && typeof menuMaskLength === "number") {
      menuTl.set(menuMaskPath, { attr: { "stroke-dashoffset": menuMaskLength } }, 0);
      menuTl.to(menuMaskPath, { attr: { "stroke-dashoffset": 0 }, ease: "none" }, 0);
    }
	    menuTl.to(
	      menuItems,
	      { opacity: 1, y: 0, duration: 0.42, ease: "power2.out", stagger: 0.06 },
	      MENU_DURATION * 0.7,
	    );

	    const closeMenu = () => {
	      if (!isMenuOpen) return;
	      isMenuOpen = false;
	      events.emitMenuToggle(false);
	      menuToggleBtn.setAttribute("aria-expanded", "false");
	      menuToggleBtn.textContent = openLabel;
	      menuTl.reverse();
	    };

		    const openMenu = () => {
		      if (isMenuOpen) return;
		      isMenuOpen = true;
		      events.emitMenuToggle(true);
		      menuToggleBtn.setAttribute("aria-expanded", "true");
		      menuToggleBtn.textContent = openLabel;
		      menuTl.play(0);
		    };

	    const toggleMenu = () => (isMenuOpen ? closeMenu() : openMenu());

	    menuToggleBtn.addEventListener("click", toggleMenu);
	    menuCloseBtn?.addEventListener("click", closeMenu);
	    window.addEventListener("keydown", (event) => {
	      if (event.key === "Escape") closeMenu();
	    });
    menu.querySelectorAll<HTMLAnchorElement>("[data-menu-item]").forEach((link) => {
      link.addEventListener("click", () => closeMenu());
    });
  });
</script>
