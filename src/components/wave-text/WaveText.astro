<canvas data-wave-text-canvas class="size-full block touch-none select-none" style="touch-action: none;"></canvas>

<script>
  import { Scene } from "./scene";
  const canvas = document.querySelector<HTMLCanvasElement>("[data-wave-text-canvas]");
  if (!canvas) throw new Error("Canvas for wave-text element not found");

  const scene = new Scene(canvas);
  scene.setSlideProgress(0);

  let isInViewport = true;
  let isDocumentVisible = document.visibilityState !== "hidden";
  let isInteracting = false;
  let isSettlingSlide = false;
  let settleTimeoutId: number | null = null;

  const VIEW_THRESHOLD = 0.2;
  const SLIDE_SETTLE_MS = 650;

  function syncRunningState() {
    const shouldRun = (isInViewport || isInteracting || isSettlingSlide) && isDocumentVisible;
    shouldRun ? scene.start() : scene.stop();
  }

  type WaveParams = { amplitude: number; frequency: number; speed: number };
  const waveParams: WaveParams = { amplitude: 190, frequency: 0.006, speed: 4 };

  function clamp(value: number, min: number, max: number) {
    return Math.max(min, Math.min(max, value));
  }

  function setWaveParams(next: Partial<WaveParams>) {
    if (typeof next.amplitude === "number") waveParams.amplitude = next.amplitude;
    if (typeof next.frequency === "number") waveParams.frequency = next.frequency;
    if (typeof next.speed === "number") waveParams.speed = next.speed;
    scene.setParams({ ...waveParams });
  }

  let activePointerId: number | null = null;
  let lastX = 0;
  let lastY = 0;

  const SENSITIVITY = {
    amplitudePerPx: 0.9,
    frequencyPerPx: 0.00001,
    speedPerPx: 0.02,
  } as const;

  const LIMITS = {
    amplitude: { min: 0, max: 500 },
    frequency: { min: 0.0005, max: 0.02 },
    speed: { min: 0, max: 20 },
  } as const;

  function onPointerDown(event: PointerEvent) {
    if (activePointerId !== null) return;
    if (event.pointerType === "mouse" && event.button !== 0) return;

    activePointerId = event.pointerId;
    lastX = event.clientX;
    lastY = event.clientY;
    isInteracting = true;
    syncRunningState();

    canvas?.setPointerCapture?.(event.pointerId);
  }

  function onPointerMove(event: PointerEvent) {
    if (activePointerId === null || event.pointerId !== activePointerId) return;

    const dx = event.clientX - lastX;
    const dy = event.clientY - lastY;
    lastX = event.clientX;
    lastY = event.clientY;

    if (event.shiftKey) {
      const nextSpeed = clamp(waveParams.speed - dy * SENSITIVITY.speedPerPx, LIMITS.speed.min, LIMITS.speed.max);
      setWaveParams({ speed: nextSpeed });
      return;
    }

    const nextAmplitude = clamp(
      waveParams.amplitude - dy * SENSITIVITY.amplitudePerPx,
      LIMITS.amplitude.min,
      LIMITS.amplitude.max,
    );
    const nextFrequency = clamp(
      waveParams.frequency + dx * SENSITIVITY.frequencyPerPx,
      LIMITS.frequency.min,
      LIMITS.frequency.max,
    );
    setWaveParams({ amplitude: nextAmplitude, frequency: nextFrequency });
  }

  function endPointer(event: PointerEvent) {
    if (activePointerId === null || event.pointerId !== activePointerId) return;
    activePointerId = null;
    isInteracting = false;
    syncRunningState();
    canvas?.releasePointerCapture?.(event.pointerId);
  }

  canvas.addEventListener("pointerdown", onPointerDown);
  canvas.addEventListener("pointermove", onPointerMove);
  canvas.addEventListener("pointerup", endPointer);
  canvas.addEventListener("pointercancel", endPointer);

  const target = canvas.closest("footer") ?? canvas;

  function cancelSlideSettle() {
    if (settleTimeoutId === null) return;
    window.clearTimeout(settleTimeoutId);
    settleTimeoutId = null;
    isSettlingSlide = false;
  }

  function startSlideSettle() {
    cancelSlideSettle();
    isSettlingSlide = true;
    settleTimeoutId = window.setTimeout(() => {
      isSettlingSlide = false;
      settleTimeoutId = null;
      syncRunningState();
    }, SLIDE_SETTLE_MS);
  }

  const observer =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            const ratio = entry?.intersectionRatio ?? 0;
            const nextInView = ratio >= VIEW_THRESHOLD;

            if (nextInView) {
              cancelSlideSettle();
              scene.setSlideProgress(1);
              isInViewport = true;
            } else {
              scene.setSlideProgress(0);
              isInViewport = false;
              startSlideSettle();
            }

            syncRunningState();
          },
          { threshold: VIEW_THRESHOLD },
        )
      : null;

  if (observer) {
    isInViewport = false;
    observer.observe(target);
  } else {
    isInViewport = true;
    scene.setSlideProgress(1);
  }

  syncRunningState();

  window.addEventListener("beforeunload", () => {
    scene.stop();
    observer?.disconnect();
    cancelSlideSettle();
  });

  window.addEventListener("visibilitychange", () => {
    isDocumentVisible = document.visibilityState !== "hidden";
    syncRunningState();
  });
</script>
