---
type Props = {
	class?: string;
};

const { class: className = "size-5" } = Astro.props;
---

<svg
	aria-hidden="true"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	class={className}
>
	<path d="M6 6 18 18" />
	<path d="M18 6 6 18" />
</svg>
