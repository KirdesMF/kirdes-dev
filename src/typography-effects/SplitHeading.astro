---
export type Props = {
	text: string;
	class?: string;
};

const { text, class: className } = Astro.props;
const letters = Array.from(text);
const rollCopies = 5;
---

<span class:list={["relative inline-flex", className]} data-rolling-heading>
	{letters.map((letter) => {
		const glyph = letter === " " ? "\u00a0" : letter;

		return (
			<span class="inline-block h-[1em] overflow-hidden pr-[0.02em] leading-none last:pr-0" data-rolling-letter-mask>
				<span class="inline-flex flex-col will-change-[filter,transform]" data-rolling-letter-track>
					{Array.from({ length: rollCopies }, (_, index) => (
						<span aria-hidden={index === 0 ? undefined : "true"}>{glyph}</span>
					))}
				</span>
			</span>
		);
	})}
</span>

<script>
import { gsap } from "gsap";

const REDUCED_MOTION_QUERY = "(prefers-reduced-motion: reduce)";
const ROLLING_HEADING_SELECTOR = "[data-rolling-heading]";
const ROLLING_LETTER_TRACK_SELECTOR = "[data-rolling-letter-track]";
const VIEW_THRESHOLD = 0.2;
const ROLL_DURATION = 1.9;
const ROLL_STAGGER = 0.045;
const ROLL_EASE = "expo.out";

let observer: IntersectionObserver | null = null;

function shouldReduceMotion(): boolean {
	return window.matchMedia?.(REDUCED_MOTION_QUERY)?.matches ?? false;
}

function getLetterTracks(heading: HTMLElement): HTMLElement[] {
	return Array.from(heading.querySelectorAll<HTMLElement>(ROLLING_LETTER_TRACK_SELECTOR));
}

function animateRoll(heading: HTMLElement): void {
	if (heading.dataset.rollingHeadingDone === "true") {
		return;
	}

	const letterTracks = getLetterTracks(heading);
	if (letterTracks.length === 0) {
		return;
	}

	heading.dataset.rollingHeadingDone = "true";
	gsap.to(letterTracks, {
		duration: ROLL_DURATION,
		filter: "blur(0px)",
		stagger: ROLL_STAGGER,
		yPercent: -80,
		ease: ROLL_EASE,
	});
}

function setupRollingHeading(heading: HTMLElement, reduceMotion: boolean): void {
	if (heading.dataset.rollingHeadingInit === "true") {
		return;
	}

	heading.dataset.rollingHeadingInit = "true";
	const letterTracks = getLetterTracks(heading);
	if (letterTracks.length === 0) {
		return;
	}

	gsap.set(letterTracks, {
		filter: "blur(0px)",
		yPercent: 0,
	});

	if (reduceMotion) {
		heading.dataset.rollingHeadingDone = "true";
		return;
	}

	gsap.set(letterTracks, { filter: "blur(8px)" });
}

function setupRollingHeadings(): void {
	const headings = Array.from(document.querySelectorAll<HTMLElement>(ROLLING_HEADING_SELECTOR));
	if (headings.length === 0) {
		return;
	}

	const reduceMotion = shouldReduceMotion();
	headings.forEach((heading) => {
		setupRollingHeading(heading, reduceMotion);
	});

	if (reduceMotion) {
		return;
	}

	if (!("IntersectionObserver" in window)) {
		headings.forEach((heading) => {
			animateRoll(heading);
		});
		return;
	}

	if (!observer) {
		observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) {
						return;
					}

					const heading = entry.target as HTMLElement;
					animateRoll(heading);
					observer?.unobserve(heading);
				});
			},
			{ threshold: VIEW_THRESHOLD },
		);
	}

	headings.forEach((heading) => {
		if (heading.dataset.rollingHeadingObserved === "true") {
			return;
		}

		heading.dataset.rollingHeadingObserved = "true";
		observer?.observe(heading);
	});
}

setupRollingHeadings();
</script>
