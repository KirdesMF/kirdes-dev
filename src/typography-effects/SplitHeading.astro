---
export type Props = {
	text: string;
	class?: string;
};

const { text, class: className } = Astro.props;
---

<span class:list={["relative inline-grid overflow-hidden", className]} data-fill-heading style="--lens-mask-radius: var(--lens-radius);">
	<span class="col-start-1 col-end-2 row-start-1 row-end-2 text-stroke text-transparent">{text}</span>
	<span
		aria-hidden="true"
		data-fill-heading-layer
		class="pointer-events-none absolute inset-0 masked-hide-local fill-foreground"
		style="clip-path: inset(0 100% 0 0);"
	>
		{text}
	</span>
	<span
		aria-hidden="true"
		data-fill-heading-layer
		class="pointer-events-none absolute inset-0 masked-reveal-local text-hatched-fill"
		style="clip-path: inset(0 100% 0 0);"
	>
		{text}
	</span>
</span>

<script>
	import { gsap } from "gsap";
	import { bindLocalLensMask } from "../visual-effects/lens/local-mask";

	const REDUCED_MOTION_QUERY = "(prefers-reduced-motion: reduce)";
	const FILL_HEADING_SELECTOR = "[data-fill-heading]";
	const VIEW_THRESHOLD = 0.2;
	const FILL_DURATION = 1.4;
	const FILL_EASE = "power2.inOut";

	let observer: IntersectionObserver | null = null;

	function shouldReduceMotion(): boolean {
		return window.matchMedia?.(REDUCED_MOTION_QUERY)?.matches ?? false;
	}

	function animateFill(heading: HTMLElement): void {
		const fillLayers = Array.from(heading.querySelectorAll<HTMLElement>("[data-fill-heading-layer]"));
		if (fillLayers.length === 0) {
			return;
		}

		if (heading.dataset.fillHeadingDone === "true") {
			return;
		}

		heading.dataset.fillHeadingDone = "true";
		gsap.fromTo(
			fillLayers,
			{ clipPath: "inset(0 100% 0 0)" },
			{
				clipPath: "inset(0 0% 0 0)",
				duration: FILL_DURATION,
				ease: FILL_EASE,
			}
		);
	}

	function setupFillHeading(heading: HTMLElement, reduceMotion: boolean): void {
		if (heading.dataset.fillHeadingInit === "true") {
			return;
		}

		heading.dataset.fillHeadingInit = "true";
		const fillLayers = Array.from(heading.querySelectorAll<HTMLElement>("[data-fill-heading-layer]"));
		if (fillLayers.length === 0) {
			return;
		}

		bindLocalLensMask({
			container: heading,
			target: heading,
			mode: "always",
		});

		if (reduceMotion) {
			fillLayers.forEach((fillLayer) => {
				fillLayer.style.clipPath = "inset(0 0% 0 0)";
			});
			heading.dataset.fillHeadingDone = "true";
		}
	}

	function setupFillHeadings(): void {
		const headings = Array.from(document.querySelectorAll<HTMLElement>(FILL_HEADING_SELECTOR));
		if (headings.length === 0) {
			return;
		}

		const reduceMotion = shouldReduceMotion();
		headings.forEach((heading) => {
			setupFillHeading(heading, reduceMotion);
		});

		if (reduceMotion) {
			return;
		}

		if (!("IntersectionObserver" in window)) {
			headings.forEach((heading) => {
				animateFill(heading);
			});
			return;
		}

		if (!observer) {
			observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) {
							return;
						}

						const heading = entry.target as HTMLElement;
						animateFill(heading);
						observer?.unobserve(heading);
					});
				},
				{ threshold: VIEW_THRESHOLD }
			);
		}

		headings.forEach((heading) => {
			if (heading.dataset.fillHeadingObserved === "true") {
				return;
			}

			heading.dataset.fillHeadingObserved = "true";
			observer?.observe(heading);
		});
	}

	setupFillHeadings();
</script>
