---
import "../styles/global.css";
import GridBackground from "../app-shell/GridBackground.astro";
import Header from "../navigation/Header.astro";
import SvgPatternDefs from "../app-shell/SvgPatternDefs.astro";
import ThemeScript from "../theme/ThemeScript.astro";

type Props = {
	lang?: string;
	title?: string;
};

const { lang = "en", title = "Cédric Gourville portfolio" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- <link rel="preload" href="/fonts/Humane-Variable.ttf" as="font" type="font/ttf" crossorigin /> -->
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body class="bg-background text-foreground font-body font-light overflow-x-hidden">
    <SvgPatternDefs />
    <GridBackground />
    <Header lang={lang} />
    <slot />
  </body>
</html>
