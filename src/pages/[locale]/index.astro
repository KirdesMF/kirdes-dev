---
import AccordiaGallery from "../../components/accordia-gallery/AccordiaGallery.astro";
import CutoutTypography from "../../components/CutoutTypography.astro";
import Flag from "../../components/flag/Flag.astro";
import HexGrid from "../../components/hex-grid/HexGrid.astro";
import CreativeDev from "../../components/illustrations/CreativeDev.astro";
import GetInTouch from "../../components/illustrations/GetInTouch.astro";
import Lens from "../../components/Lens.astro";
import Menu from "../../components/Menu.astro";
import ProcessCard from "../../components/ProcessCard.astro";
import SplitHeading from "../../components/SplitHeading.astro";
import SmearText from "../../components/smear-text/SmearText.astro";
import Sunburst from "../../components/sunburst/Sunburst.astro";
import WaveText from "../../components/wave-text/WaveText.astro";
import Layout from "../../layouts/Layout.astro";
import { getLangFromURL, useTranslations } from "../../i18n/utils";
import Sparkle from "../../components/illustrations/Sparkle.astro";
import ElasticArrow from "../../components/illustrations/ElasticArrow.astro";

const lang = getLangFromURL(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "fr" } }];
}

const splitedText = "Building".split("");
---

<Layout>
  <Lens />
  <Menu />

  <button data-theme class="border px-4 py-1 fixed tracking-wider">Theme</button>
  <svg aria-hidden="true" width="0" height="0" class="fixed inset-0 overflow-visible pointer-events-none">
    <defs>
      <clipPath id="theme-transition-clip" clipPathUnits="objectBoundingBox">
        <path data-theme-transition-path></path>
      </clipPath>
    </defs>
  </svg>

  <main class="min-h-dvh grid">
    <section id="intro" class="grid gap-32 py-48 px-32 place-items-center">
      <div class="w-2/3 mx-auto">
        <h1 class="sr-only">{t("hero.title")}</h1>
        <div aria-hidden="true" class="text-9xl font-bold text-center grid">
          <div class="flex gap-4 relative">
            <Sparkle class="absolute -top-15 -end-15 fill-foreground w-24 h-24" />
            <Sparkle class="absolute -top-2 -end-25 fill-foreground w-20 h-20" />

            <div class="overflow-hidden relative">
              <div data-motion="building">
                {
                  splitedText.map((letter) => (
                    <span
                      data-letter={letter}
                      class:list={[
                        "inline-block -translate-y-[105%] hover:font-extralight transition-[font-weight] duration-300 ease-in-out",
                        "before:content-[attr(data-letter)] before:font-bold before:invisible before:block before:h-0",
                      ]}
                    >
                      {letter}
                    </span>
                  ))
                }
              </div>
            </div>
            <span>cool</span>
            <span class="border px-4 bg-foreground text-background relative">
              <span>stuff</span>
            </span>
          </div>
          <div class="flex gap-6">
            <ElasticArrow />

            <div class="flex gap-4">
              <div class="grid relative">
                <span data-masked class="col-start-1 col-end-2 row-start-1 row-end-2 masked-hide">for</span>
                <span data-masked class="absolute inset-0 text-stroke text-transparent masked-reveal">for </span>
              </div>
              <span>the</span>
              <span>web</span>
              <div class="grid relative">
                <span data-masked class="col-start-1 col-end-2 row-start-1 row-end-2 masked-hide">.</span>
                <span data-masked class="absolute inset-0 text-stroke text-transparent masked-reveal">.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-12 gap-6 w-full">
        <div class="col-span-full grid">
          <CreativeDev class="fill-none stroke-foreground stroke-2" />
        </div>

        <div class="col-span-full -mt-20">
          <Sunburst />
        </div>

        <div class="col-span-full relative border h-112.5">
          <div class="absolute inset-0 size-full bg-background">
            <SmearText />
          </div>
        </div>
      </div>
    </section>

    <section id="works" class="pb-48">
      <div class="grid grid-cols-12 gap-6 px-32">
        <div class="col-span-6">
          <h2 class="text-[200px] font-bold leading-none">
            <SplitHeading text="Works" />
          </h2>
        </div>
      </div>

      <AccordiaGallery />
    </section>

    <section id="process" class="pb-48 px-32">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-start-7 col-span-6 flex justify-end">
          <h2 class="text-[200px] font-bold">
            <SplitHeading text="Process" />
          </h2>
        </div>
      </div>

      <div class="grid h-svh grid-cols-12 gap-6">
        <ProcessCard count={1} hasLine={false} class="col-span-3" />
        <ProcessCard count={2} class="col-span-3" />
        <ProcessCard count={3} class="col-span-3" />
        <ProcessCard count={4} class="col-span-3" />
      </div>
    </section>

    <section id="about" class="pb-48 px-32">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-6">
          <h2 class="text-[200px] font-bold">
            <SplitHeading text="About" />
          </h2>
        </div>
      </div>

      <HexGrid />
    </section>

    <footer id="footer" class="px-32">
      <div class="h-svh grid grid-rows-[2fr_1fr] gap-6">
        <div class="col-span-full relative border">
          <div class="absolute inset-0 size-full">
            <WaveText />
          </div>
        </div>

        <div class="col-span-full relative">
          <GetInTouch />
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style is:global>
  /* View Transitions (GSAP-driven SVG clipPath) */
  :root {
    --theme-transition-duration: 900ms;
  }

  ::view-transition-old(root) {
    animation: none;
  }

  ::view-transition-new(root) {
    clip-path: url(#theme-transition-clip);
    animation: theme-transition-hold var(--theme-transition-duration) both;
  }

  @keyframes theme-transition-hold {
    from {
      opacity: 1;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import { events, state } from "../../lib/states";
  import { gsap } from "gsap";

  const btn = document.querySelector<HTMLButtonElement>("[data-theme]");
  const transitionPath = document.querySelector<SVGPathElement>("[data-theme-transition-path]");

  const RECT = "M0 0 C0 0 1 0 1 0 C1 0 1 1 1 1 C1 1 0 1 0 1 C0 1 0 0 0 0 Z";

  const circlePath = (r: number) => {
    const cx = 0.5;
    const cy = 0.5;
    const k = 0.5522847498307936;
    const kr = k * r;
    const fmt = (n: number) => Number(n.toFixed(6));

    return [
      `M${fmt(cx + r)} ${fmt(cy)}`,
      `C${fmt(cx + r)} ${fmt(cy + kr)} ${fmt(cx + kr)} ${fmt(cy + r)} ${fmt(cx)} ${fmt(cy + r)}`,
      `C${fmt(cx - kr)} ${fmt(cy + r)} ${fmt(cx - r)} ${fmt(cy + kr)} ${fmt(cx - r)} ${fmt(cy)}`,
      `C${fmt(cx - r)} ${fmt(cy - kr)} ${fmt(cx - kr)} ${fmt(cy - r)} ${fmt(cx)} ${fmt(cy - r)}`,
      `C${fmt(cx + kr)} ${fmt(cy - r)} ${fmt(cx + r)} ${fmt(cy - kr)} ${fmt(cx + r)} ${fmt(cy)}`,
      "Z",
    ].join(" ");
  };

  let isTransitioning = false;

  btn?.addEventListener("click", async () => {
    if (isTransitioning) return;

    const newTheme = state.getTheme() === "dark" ? "light" : "dark";
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const startViewTransition = (
      document as Document & {
        startViewTransition?: (callback: () => void) => { ready: Promise<void> };
      }
    ).startViewTransition;

    if (!transitionPath || typeof startViewTransition !== "function" || prefersReducedMotion) {
      events.emitThemeChange(newTheme);
      return;
    }

    isTransitioning = true;
    btn?.setAttribute("aria-busy", "true");

    try {
      const START = circlePath(0.01);
      transitionPath.setAttribute("d", START);

      const transition = startViewTransition.call(document, () => {
        events.emitThemeChange(newTheme);
      });

      await transition.ready;

      await new Promise<void>((resolve) => {
        gsap.to(transitionPath, {
          attr: { d: RECT },
          duration: 0.9,
          ease: "power2.inOut",
          onComplete: () => resolve(),
        });
      });
    } catch {
    } finally {
      btn?.removeAttribute("aria-busy");
      isTransitioning = false;
    }
  });

  //------------------------
  const building = document.querySelector<HTMLDivElement>("[data-motion='building']")!.querySelectorAll("span");
  const motionArray = gsap.utils.toArray(building);

  gsap.to(motionArray, {
    duration: 1,
    y: "0%",
    stagger: 0.1,
    ease: "bounce",
  });
</script>
