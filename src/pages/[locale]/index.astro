---
import AccordiaGallery from "../../components/accordia-gallery/AccordiaGallery.astro";
import CursorMask from "../../components/CursorMask.astro";
import CreativeDev from "../../components/illustrations/CreativeDev.astro";
import ElasticArrow from "../../components/illustrations/ElasticArrow.astro";
import GetInTouch from "../../components/illustrations/GetInTouch.astro";
import Sparkle from "../../components/illustrations/Sparkle.astro";
import Lens from "../../components/Lens.astro";
import PixiEyesHero from "../../components/pixi-eyes/PixiEyesHero.astro";
import SplitHeading from "../../components/SplitHeading.astro";
import Sunburst from "../../components/sunburst/Sunburst.astro";
import { getLangFromURL, useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";

const lang = getLangFromURL(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
	return [{ params: { locale: "en" } }, { params: { locale: "fr" } }];
}

const buildingLetters = t("hero.building").split("");
---

<Layout lang={lang}>
	<Lens />

	<main class="min-h-dvh grid pt-24">
		<section class="relative overflow-hidden">
			<div class="relative h-[70svh] min-h-128"><PixiEyesHero class="absolute inset-0" /></div>

			<div class="relative z-10 grid place-items-center px-6 pb-12 pt-8 sm:px-10 lg:px-16 lg:pb-20 pointer-events-none">
				<h1 class="sr-only">{t("hero.title")}</h1>
				<div
					aria-hidden="true"
					class="grid justify-center gap-2 text-center font-bold leading-[0.9] tracking-[-0.03em] text-[clamp(3.4rem,10vw,8rem)] sm:gap-3 lg:text-[clamp(5rem,9vw,9rem)]"
				>
					<div class="flex flex-wrap items-end justify-center gap-x-3 gap-y-2 sm:gap-x-4">
						<div class="overflow-hidden relative">
							<div data-motion="building">
								{buildingLetters.map((letter) => (
                    <span
                      data-letter={letter}
                      class:list={[
                        "inline-block -translate-y-[105%] pr-[0.04em] last:pr-0 hover:font-extralight transition-[font-weight] duration-300 ease-in-out",
                        "before:content-[attr(data-letter)] before:font-bold before:invisible before:block before:h-0",
                      ]}
                    >
                      {letter}
                    </span>
                  ))}
							</div>
						</div>
						<span>{t("hero.cool")}</span>
						<span class="relative border bg-foreground px-[0.18em] text-background">
							<span>{t("hero.stuff")}</span>
							<Sparkle
								data-title-sparkle
								class="absolute -inset-e-[0.48em] -top-[0.46em] h-[0.64em] w-[0.64em] fill-foreground"
							/>
							<Sparkle
								data-title-sparkle
								class="absolute -inset-e-[0.74em] top-[0.02em] h-[0.64em] w-[0.64em] fill-foreground"
							/>
						</span>
					</div>
					<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 sm:gap-x-6">
						<div class="hidden lg:block"><ElasticArrow /></div>

						<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 sm:gap-x-4">
							<CursorMask>
								<span slot="base">{t("hero.for")}</span>
								<span slot="reveal" class="text-stroke text-transparent">{t("hero.for")}</span>
							</CursorMask>
							<span>{t("hero.the")}</span>
							<span>{t("hero.web")}</span>
							<CursorMask class="pointer-events-none">
								<span slot="base">.</span>
								<span slot="reveal" class="text-stroke text-transparent">.</span>
							</CursorMask>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="intro" class="grid gap-20 px-6 py-24 sm:px-10 lg:gap-32 lg:px-32 lg:py-48 place-items-center">
			<div class="grid grid-cols-12 gap-6 w-full">
				<div class="col-span-full grid"><CreativeDev class="fill-none stroke-foreground stroke-2" /></div>

				<div class="col-span-full -mt-20"><Sunburst /></div>
			</div>
		</section>

		<section id="works" class="pb-48">
			<div class="grid grid-cols-12 gap-6 px-32">
				<div class="col-span-6">
					<h2 class="text-[200px] font-bold leading-none"><SplitHeading text={t("section.works")} /></h2>
				</div>
			</div>

			<AccordiaGallery />
		</section>

		<section id="about" class="pb-48 px-32">
			<div class="grid grid-cols-12 gap-6">
				<div class="col-span-6">
					<h2 class="text-[200px] font-bold leading-none"><SplitHeading text={t("section.about")} /></h2>
				</div>
			</div>
		</section>

		<footer id="footer" class="px-32">
			<div class="h-svh grid grid-rows-[2fr_1fr] gap-6">
				<div class="col-span-full relative"><GetInTouch /></div>
			</div>
		</footer>
	</main>
</Layout>

<script>
import { gsap } from "gsap";

const building = document.querySelector<HTMLDivElement>("[data-motion='building']")?.querySelectorAll("span");
const motionArray = gsap.utils.toArray(building ?? []);
const titleSparkles = gsap.utils.toArray<SVGElement>("[data-title-sparkle]");

gsap.to(motionArray, {
	duration: 1,
	y: "0%",
	stagger: 0.1,
	ease: "bounce",
});

if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && titleSparkles.length > 0) {
	gsap.set(titleSparkles, { transformOrigin: "50% 50%" });
	const sparkleTl = gsap.timeline({ repeat: -1, yoyo: true, defaults: { duration: 0.9, ease: "sine.inOut" } });

	sparkleTl.to(titleSparkles[0], { scale: 1.18 }, 0).to(titleSparkles[1], { scale: 0.82 }, 0);
}
</script>
